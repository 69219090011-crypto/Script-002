local player = game.Players.LocalPlayer
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- ===== GUI =====
local gui = Instance.new("ScreenGui", player:WaitForChild("PlayerGui"))
gui.ResetOnSpawn = false

local frame = Instance.new("Frame", gui)
frame.Size = UDim2.new(0,220,0,200)
frame.Position = UDim2.new(0,20,0,200)
frame.BackgroundColor3 = Color3.fromRGB(30,30,30)
frame.Active = true
frame.Draggable = true

local title = Instance.new("TextLabel", frame)
title.Size = UDim2.new(1,0,0,30)
title.Text = "เลือกผู้เล่น"
title.BackgroundTransparency = 1

local list = Instance.new("ScrollingFrame", frame)
list.Size = UDim2.new(1,-20,0,120)
list.Position = UDim2.new(0,10,0,30)
list.CanvasSize = UDim2.new(0,0,0,0)
list.BackgroundColor3 = Color3.fromRGB(40,40,40)

local layout = Instance.new("UIListLayout", list)

local toggle = Instance.new("TextButton", frame)
toggle.Size = UDim2.new(1,-20,0,30)
toggle.Position = UDim2.new(0,10,0,160)
toggle.Text = "FOLLOW: OFF"

-- ===== ตัวแปร =====
local targetPlayer = nil
local following = false

-- ===== สร้างปุ่มรายชื่อ =====
local function refreshList()
	list:ClearAllChildren()
	layout.Parent = list
	
	for _, plr in pairs(Players:GetPlayers()) do
		if plr ~= player then
			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1,0,0,30)
			btn.Text = plr.Name
			btn.Parent = list
			
			btn.MouseButton1Click:Connect(function()
				targetPlayer = plr
			end)
		end
	end
	
	list.CanvasSize = UDim2.new(0,0,0,layout.AbsoluteContentSize.Y)
end

refreshList()
Players.PlayerAdded:Connect(refreshList)
Players.PlayerRemoving:Connect(refreshList)

-- ===== ปุ่มเปิด/ปิด =====
toggle.MouseButton1Click:Connect(function()
	following = not following
	
	if following then
		toggle.Text = "FOLLOW: ON"
	else
		toggle.Text = "FOLLOW: OFF"
	end
end)

-- ===== ระบบตาม =====
RunService.RenderStepped:Connect(function()
	if following and targetPlayer then
		local myChar = player.Character
		local targetChar = targetPlayer.Character
		
		if myChar and targetChar then
			local myRoot = myChar:FindFirstChild("HumanoidRootPart")
			local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
			
			if myRoot and targetRoot then
				myRoot.CFrame = targetRoot.CFrame * CFrame.new(0,0,3)
			end
		end
	end
end)

-- ===== ตายแล้วไม่หาย =====
player.CharacterAdded:Connect(function()
	task.wait(1)
end)
