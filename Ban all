-- เพิ่มใน Players.PlayerAdded > player.Chatted

elseif args[1] == "!banall" then
    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player then  -- ไม่แบนตัวเอง
            bannedPlayers[target.UserId] = true
            target:Kick("🚫 คุณถูกแบนโดยแอดมิน")
        end
    end
    print("[ADMIN] " .. player.Name .. " แบนผู้เล่นทั้งหมด")

elseif args[1] == "!kickall" then
    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player then  -- ไม่ kick ตัวเอง
            target:Kick("👢 คุณถูก Kick โดยแอดมิน")
        end
    end
    print("[ADMIN] " .. player.Name .. " kick ผู้เล่นทั้งหมด")
